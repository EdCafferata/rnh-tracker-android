<?xml version="1.0" encoding="utf-8"?>
<!-- Back-up-regels voor Android 8-11 (fullBackupContent). Alleen met end-to-end-versleuteling (clientSideEncryption). -->
<full-backup-content>
    <include domain="sharedpref" path="." requireFlags="clientSideEncryption" />
    <include domain="file" path="." requireFlags="clientSideEncryption" />
    <exclude domain="file" path="osmdroid" />
</full-backup-content>
